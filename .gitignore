data/noba_raw.json

# Finder/iCloud conflict copies of the built site ("site 2", "site 7"), made while a
# build rewrote site/ during a sync -- never part of the project
site [0-9]*/

# OAI-PMH answers, one per object, re-derivable
data/oaicache/

# The built site. pages.yml builds it from data/data.json and deploys it; it was
# committed for a year and made .git 519 MB. static/ (CNAME etc.) stays tracked.
site/

# CLIP embeddings of the museum pictures (data/lookalikes.py): recomputed from the
# pictures themselves, which are never stored; the neighbours file is committed
data/embcache/
.venv-clip/

# Finder/iCloud conflict copies of data files rewritten mid-sync ("chart_sides 2.json")
data/* [0-9].json

# derived at every build by data/similar.py, read beside data.json
data/similar.json
# one-off probes of a source's pages, kept locally while writing a parser
data/*_probe.json
# retired: the single-file Claude Artifact snapshot (it could not follow the split index)
register.html
