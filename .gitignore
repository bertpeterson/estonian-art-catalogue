data/dk_list.json
data/dk_list2.json
data/harvest.json
data/harvest2.json
data/ekm_all_list.json

# Scratch pages saved while working out selectors, and run logs
data/*.html
data/*.log
data/*.txt

# OS / editor
.DS_Store

