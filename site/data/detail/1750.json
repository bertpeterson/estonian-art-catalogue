{"6198":{"dm":"laius: 28.4 cm (lm); kõrgus: 19.5 cm (lm)","d":"Öises maastikus, ees paremal veekogu paadiga ja kahe sõudjaga. Vasakul kaldavõsa. Tagapool, keskel, kuust valgustatud loss.","mi":"1447257"},"7246":{"dm":"laius: 28.4 cm (lm); kõrgus: 21.0 cm (lm)","d":"Eest paremalt taha vasakule kaljude vahele voolav jõeke. Tagapool kaljuseid vastaskaldaid ühendav puust kaarjas sild suunaga vasakult paremalt. Üksikute inimfiguuridega sellel ja ees. Paremal vastakaldal üksikuid kuuski.","mi":"1448635"},"7395":{"dm":"laius: 42.0 cm; kõrgus: 49.6 cm","d":"Mehe rinnapilt poolprofiilis vasemale, pilk suunatud paremale. Rinnas krooniga order monogrammiga.","mi":"1448879","oi":"27620"},"7846":{"dm":"laius: 43.7 cm (vm.); kõrgus: 29.1 cm (vm.)","d":"Ees vasakul joonia stiilis monumendi vare. Selle juures 3 inimfiguuri. Paremal, poollängu kasvanud lehtpuu- Keskel, järve kaldal kitse kari ja üksik ratsanik. Taamal kaljuplatool sammasehitiste (templite) varemed.","mi":"2300314","oi":"12239","mem":[["EKM j 190:368 M 700","tempera","1756","2300314",""],["EKM j 190/368 M 700","tempera, guašš","1756","","12239"]]},"10445":{"dm":"kõrgus: 62.0 cm; laius: 48.7 cm","mi":"98795"},"10446":{"dm":"laius: 51.5 cm; kõrgus: 70.0 cm","mi":"98796"},"23926":{"dm":"laius: 66.5 cm; kõrgus: 87.0 cm","mi":"1530795"},"34069":{"oi":"33701"},"45048":{"oi":"2265"},"45099":{"oi":"19823"},"45100":{"dm":"plaadimõõt 40.9 x 60.5","oi":"16806"},"45103":{"oi":"19824"},"45106":{"oi":"19826"},"45107":{"oi":"19860"},"45131":{"oi":"2368"},"45133":{"oi":"2370"},"45200":{"oi":"20493"},"45432":{"oi":"25572"},"45529":{"oi":"34315"},"45871":{"oi":"31046"},"45886":{"oi":"38505"},"46001":{"oi":"37861"},"46143":{"oi":"34316"},"46145":{"oi":"38426"},"46154":{"dm":"lehemõõt 23.8 x 32.1","oi":"16157"},"46219":{"oi":"34306"},"46709":{"oi":"38712"},"46710":{"oi":"38713"},"46732":{"oi":"33770"},"46847":{"oi":"21142"},"46848":{"oi":"21143"},"46862":{"oi":"1200"},"46899":{"oi":"1056"},"46914":{"oi":"8281"},"46941":{"oi":"1205"},"47